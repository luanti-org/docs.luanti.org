// cSpell Settings
{
  // Version of the setting file.  Always 0.2
  "version": "0.2",
  // language - current active spelling language
  "language": "en",
  // patterns - regular expressions that can be referenced in ignoreRegExpList
  "patterns": [
    // fenced code blocks: ``` or ~~~
    {
      "name": "markdown-code-block",
      "pattern": "/^\\s*(`{3,}|~{3,})[\\s\\S]*?^\\s*\\1/gm"
    },
    // inline code: `code`
    {
      "name": "markdown-inline-code",
      "pattern": "/`[^`\\n]+`/g"
    },
    // contributor credits in the changelog: (_nickname_) or (_nick1_, _nick2_)
    {
      "name": "changelog-credits",
      "pattern": "/\\(_[^)\\n]*_\\)/g"
    }
  ],
  // don't spell check code in Markdown: identifiers there aren't words
  "languageSettings": [
    {
      "languageId": "markdown",
      "ignoreRegExpList": ["markdown-code-block", "markdown-inline-code"]
    }
  ],
  // per-file settings
  "overrides": [
    {
      "filename": "content/about/changelog.md",
      "ignoreRegExpList": ["changelog-credits"]
    }
  ],
  // project dictionaries, one word per line; add new words to the matching file
  "dictionaryDefinitions": [
    { "name": "people", "path": "./.cspell/people.txt", "addWords": true },
    { "name": "luanti", "path": "./.cspell/luanti.txt", "addWords": true },
    { "name": "software", "path": "./.cspell/software.txt", "addWords": true },
    { "name": "english", "path": "./.cspell/english.txt", "addWords": true }
  ],
  "dictionaries": ["people", "luanti", "software", "english"],
  // flagWords - list of words to be always considered incorrect
  // This is useful for offensive words and common spelling errors.
  // For example "hte" should be "the"
  // "dependant" is a real noun but almost always a typo for "dependent" (adj)
  "flagWords": [
    "hte",
    "dependant"
  ]
}
